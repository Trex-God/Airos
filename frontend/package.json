    "@tanstack/react-query": "5.56.2",
    "@types/dompurify": "3.0.5",
    "dompurify": "3.4.15",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.1",
    "stripe": "22.2.0",
    "svix": "^1.96.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testing-library/jest-dom": "6.9.1",
