{
  "name": "Execution Logger",
  "nodes": [
    {
      "parameters": {},
      "id": "17861d80-eb80-4882-b934-d1aa7aa52de9",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "42979cfc-e63a-4129-8f41-86c2b04a7641",
              "name": "input_summary",
              "value": "={{ String($json.input_text ?? '').slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "2dc75c33-a9ae-413a-b4b2-0ccf201ae736",
              "name": "output_summary",
              "value": "={{ String($json.output_text ?? '').slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "22b68279-0208-453a-902a-d3fb9466730a",
              "name": "action",
              "value": "agent.execution",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "2aeb9997-8234-498c-981b-ff9fa247788f",
      "name": "Prepare Log Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        280,
        300
      ],
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/agent_execution_logs' }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { task_id: $json.task_id, user_id: $json.user_id, agent_id: $json.agent_id, model_used: $json.model_used, workflow_name: $json.workflow_name, node_name: $json.node_name, action: $json.action, input_summary: $json.input_summary, output_summary: $json.output_summary, tokens_input: Number($json.tokens_input ?? 0), tokens_output: Number($json.tokens_output ?? 0), duration_ms: Number($json.duration_ms ?? 0), success: Boolean($json.success), error_message: $json.error_message || null } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 60000
        }
      },
      "id": "a28b76ee-1635-451e-a019-10ddad314096",
      "name": "Insert Execution Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/tasks?id=eq.' + $node[\"Prepare Log Data\"].json.task_id }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { status: 'complete', completed_at: new Date().toISOString() } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 60000
        }
      },
      "id": "37e9fb9f-b291-46be-949f-d4c2f63c13c8",
      "name": "Mark Task Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        300
      ],
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "297d57ee-1124-48e5-b18e-c511b5db0498",
              "name": "logged",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "35a2b060-eec8-4b53-95fd-6445574ea50c",
      "name": "Respond to Execute Workflow",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        300
      ],
      "alwaysOutputData": true,
      "continueOnFail": true
    }
  ],
  "pinData": {},
