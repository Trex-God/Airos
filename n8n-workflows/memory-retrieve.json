  "versionId": "5e7c21f7-f7bb-44d3-ae3c-51df3bd64988",
  "meta": {
    "templateCredsSetupCompleted": false,
    "templateVersion": "airos-memory-retrieve-v1",
    "sql_function_comment": "CREATE OR REPLACE FUNCTION match_memories(\n  query_embedding vector(768),\n  match_user_id text,\n  match_count int DEFAULT 5\n)\nRETURNS TABLE (id uuid, content text, category text, importance float, similarity float)\nLANGUAGE plpgsql AS $$\nBEGIN\n  RETURN QUERY\n  SELECT m.id, m.content, m.category, m.importance,\n    1 - (m.embedding <=> query_embedding) AS similarity\n  FROM memory_items m\n  WHERE m.user_id = match_user_id\n  ORDER BY m.embedding <=> query_embedding\n  LIMIT match_count;\nEND;\n$$;"
  },
