      "id": "a03722de-3cb7-4f70-bcdd-ce8fbe44733f",
      "name": "Handle Empty Results",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst memories = items.flatMap((item) => {\n  const value = item.json;\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value.data)) return value.data;\n  if (value && value.id && value.content) return [value];\n  return [];\n});\n\nconst memoryContext = memories\n  .slice(0, 5)\n  .map((memory) => `[MEMORY: ${memory.category}] ${memory.content}`)\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      memory_context: memoryContext,\n    },\n  },\n];"
      },
