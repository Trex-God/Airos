              "id": "a8469d4f-ae54-4c7f-9ca0-c58bd914394d",
              "leftValue": "={{ Array.isArray($json) ? $json.length : ($json.id && $json.content ? 1 : (Array.isArray($json.data) ? $json.data.length : 0)) }}",
